# Vercel Web Analytics and Speed Insights need nothing here — they are
# enabled per-project in the Vercel dashboard and inject themselves at the
# edge. Everything below is PostHog.

# Project API key ("Project settings → API keys" in PostHog). This is a
# write-only public key and ships in the client bundle by design; it is not
# a secret. Without it, initAnalytics() returns immediately and posthog-js
# is never even fetched.
VITE_POSTHOG_KEY=

# Ingest host. Defaults to /ingest, the same-origin proxy declared in
# vercel.json, which is what keeps ad blockers from eating the numbers.
# Point it at https://us.i.posthog.com to bypass the proxy — useful on a
# preview deploy that does not carry the rewrite.
# VITE_POSTHOG_HOST=/ingest

# Only used to build links back into the PostHog UI. EU projects want
# https://eu.posthog.com (and the vercel.json rewrites need the matching
# eu.i.posthog.com / eu-assets.i.posthog.com destinations).
# VITE_POSTHOG_UI_HOST=https://us.posthog.com

# `npm run dev` stays silent even with a key set, so local clicking around
# never lands in the production project. Set this to 1 to check that new
# instrumentation actually fires.
# VITE_POSTHOG_DEV=1

# Not set by hand: Vercel injects VITE_VERCEL_ENV (production | preview |
# development) into Vite builds on its own, and analytics.js registers it
# as a super property so every event says which deployment it came from.
# Requires "Automatically expose System Environment Variables" in project
# settings, which is on by default. Locally it is absent and events are
# tagged "unknown" — which only happens with VITE_POSTHOG_DEV=1 anyway.

# ---------------------------------------------------------------------------
# Web push (api/push-subscribe.js, api/send-digest.js). Server-side only —
# none of these are VITE_-prefixed, so none reach the client bundle; the
# browser gets the PUBLIC key from GET /api/push-subscribe at runtime.
#
# Generate a pair once with:   npx web-push generate-vapid-keys
# and never rotate casually: every existing subscription is bound to the
# public key it was made with, and stops receiving pushes when it changes.
# With either key unset, push is simply off — the subscribe endpoint reports
# { enabled:false } and the digest cron returns a no-op message.
# Subscriptions are kept in the same Vercel Blob store as the feed caches
# (RR_BLOB_READ_WRITE_TOKEN), one file per subscriber under push/subs/.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach if our pushes misbehave.
VAPID_SUBJECT=mailto:hello@yanked.app

# Vercel cron sends `Authorization: Bearer <CRON_SECRET>` on every scheduled
# call. When set, /api/refresh-feeds refuses anything without it. With push
# configured (VAPID keys set), /api/send-digest REQUIRES it and answers 503
# until it is set: it sends pushes and its ?dry=1 preview shows subscribers'
# states and follow terms.
CRON_SECRET=

# Only on a Blob store created as private; a public store refuses private
# writes. See src/lib/push-store.js.
# PUSH_BLOB_ACCESS=private

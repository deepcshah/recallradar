# Vercel Web Analytics and Speed Insights need nothing here — they are
# enabled per-project in the Vercel dashboard and inject themselves at the
# edge. Everything below is PostHog.

# Project API key ("Project settings → API keys" in PostHog). This is a
# write-only public key and ships in the client bundle by design; it is not
# a secret. Without it, initAnalytics() returns immediately and posthog-js
# is never even fetched.
VITE_POSTHOG_KEY=

# Ingest host. Defaults to /ingest, the same-origin proxy declared in
# vercel.json, which is what keeps ad blockers from eating the numbers.
# Point it at https://us.i.posthog.com to bypass the proxy — useful on a
# preview deploy that does not carry the rewrite.
# VITE_POSTHOG_HOST=/ingest

# Only used to build links back into the PostHog UI. EU projects want
# https://eu.posthog.com (and the vercel.json rewrites need the matching
# eu.i.posthog.com / eu-assets.i.posthog.com destinations).
# VITE_POSTHOG_UI_HOST=https://us.posthog.com

# `npm run dev` stays silent even with a key set, so local clicking around
# never lands in the production project. Set this to 1 to check that new
# instrumentation actually fires.
# VITE_POSTHOG_DEV=1
